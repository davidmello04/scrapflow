{
  "name": "scrapflow",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "npm run dev --workspace @scrapflow/api",
    "dev:mobile": "npm run start --workspace @scrapflow/mobile",
    "build": "npm run build --workspace @scrapflow/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": { "node": ">=20", "npm": ">=10" }
}
